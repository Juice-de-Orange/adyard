# Template -- adapt the lines below each "# ADJUST:" comment, then install
# to /etc/systemd/system/. Lines without that mark work as they are.
# See docs/deploy/systemd.md.
[Unit]
Description=Adyard media worker (image and video optimisation)
Documentation=https://github.com/Juice-de-Orange/adyard
After=adyard.service
# ADJUST: the data directory (ADYARD_BASE).
RequiresMountsFor=/srv/adyard

[Service]
Type=exec
# ADJUST: the account the service runs as.
User=adyard
Group=adyard
# ADJUST: the checkout of this repository.
WorkingDirectory=/opt/adyard
Environment=PYTHONUNBUFFERED=1
# ADJUST: the data directory.
Environment=ADYARD_BASE=/srv/adyard
# ADJUST: the environment file (see .env.example).
EnvironmentFile=-/etc/adyard.env
# ADJUST: the data directory (ADYARD_BASE).
ExecStartPre=/usr/bin/test -f /srv/adyard/.mounted
# ADJUST: the venv path.
ExecStart=/opt/adyard/venv/bin/python -m app.worker
Restart=on-failure
RestartSec=5
# Transcoding must never starve the web service.
Nice=10
IOSchedulingClass=idle
# The worker sleeps most of the time; when it works it may compute for a
# while, but it queues behind everything else.
CPUWeight=20
IOWeight=20


# ── Frugality ─────────────────────────────────────────────────────────────
# Same runtime directory as the web unit: the wake-up pipe lives in RAM.
RuntimeDirectory=adyard
RuntimeDirectoryMode=0750
# See adyard.service: without this the FIFO disappears when one unit stops.
RuntimeDirectoryPreserve=yes

# ffmpeg needs room for large videos -- the limit is deliberately generous.
MemoryMax=1G
TasksMax=64

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# ADJUST: the data directory (ADYARD_BASE).
ReadWritePaths=/srv/adyard
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
