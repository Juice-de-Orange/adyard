# Template -- adapt the lines below each "# ADJUST:" comment, then install
# to /etc/systemd/system/. Lines without that mark work as they are.
# See docs/deploy/systemd.md.
[Unit]
Description=Adyard web service
Documentation=https://github.com/Juice-de-Orange/adyard
After=network-online.target
Wants=network-online.target
# ADJUST: the data directory (ADYARD_BASE). If it is a separate disk, systemd
# waits for it.
RequiresMountsFor=/srv/adyard

[Service]
Type=exec
# ADJUST: the account the service runs as.
User=adyard
Group=adyard
# ADJUST: the checkout of this repository.
WorkingDirectory=/opt/adyard
Environment=PYTHONUNBUFFERED=1
# ADJUST: the data directory.
Environment=ADYARD_BASE=/srv/adyard
# ADJUST: the environment file (see .env.example).
EnvironmentFile=-/etc/adyard.env
# Refuse to start when the data disk is gone. Without this the service would
# happily write into an empty directory on the system disk and lose every upload.
# ADJUST: the data directory (ADYARD_BASE).
ExecStartPre=/usr/bin/test -f /srv/adyard/.mounted
# --no-access-log: the reverse proxy already logs every request. A second line
# per banner request only costs writes and says nothing new.
# --no-proxy-headers: which proxy may set X-Forwarded-For is decided by the app
# (ADYARD_TRUSTED_PROXIES in the environment file, default 127.0.0.1 and ::1).
# ADJUST: the venv path; --host and --port if the reverse proxy runs on another
# machine (then also ADYARD_TRUSTED_PROXIES).
ExecStart=/opt/adyard/venv/bin/uvicorn app.main:create_app --factory \
          --host 127.0.0.1 --port 8080 --no-proxy-headers \
          --no-access-log --timeout-keep-alive 15
Restart=on-failure
RestartSec=5


# ── Frugality ─────────────────────────────────────────────────────────────
# RuntimeDirectory creates /run/adyard as a tmpfs directory (owned by adyard).
# The wake-up pipe between web and worker lives there -- in RAM, not on disk.
RuntimeDirectory=adyard
RuntimeDirectoryMode=0750
# Without this systemd removes /run/adyard as soon as ONE of the two units
# stops -- the worker would then hold a descriptor to a deleted FIFO and never
# be woken again. The fallback timer hides that, so it only shows when an
# upload hangs for five minutes.
RuntimeDirectoryPreserve=yes

# Upper limits so that a bug cannot take the host down. They should never
# apply in normal operation -- measured, the service sits at about 40 MB.
MemoryMax=384M
MemoryHigh=256M
TasksMax=64

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# ADJUST: the data directory (ADYARD_BASE).
ReadWritePaths=/srv/adyard
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
